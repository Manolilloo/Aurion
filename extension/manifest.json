{
  "manifest_version": 3,
  "name": "Aurion Link Sniffer",
  "version": "2.4",
  "description": "Detector multimedia avanzado Liquid Glass para Aurion Downloader",
  "permissions": [
    "activeTab",
    "webRequest",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:6800/*",
    "http://localhost:6800/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aurion Sniffer"
  }
}